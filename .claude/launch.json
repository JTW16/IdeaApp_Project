{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "idea-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "idea-helper/server", "run", "start"],
      "port": 4000
    },
    {
      "name": "idea-app-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "idea-helper/app", "run", "web", "--", "--port", "8081"],
      "port": 8081,
      "env": { "BROWSER": "none" }
    }
  ]
}
