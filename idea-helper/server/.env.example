# 서버 포트
PORT=4000

# 비워 두면 내장 PostgreSQL(PGlite, ./.data/pglite)로 동작합니다.
# Supabase: 대시보드 상단 'Connect' → 'Session pooler'의 주소를 붙여 넣고 [YOUR-PASSWORD]를 DB 비밀번호로 바꿉니다.
#   (Direct connection은 무료 플랜에서 IPv6 전용이라 집 · 학교 인터넷에서 안 될 수 있음. Session pooler는 IPv4 · 포트 5432)
#   비밀번호에 @ : / ? # 같은 기호가 있으면 퍼센트 인코딩해야 합니다 (예: @ → %40)
# 내장 DB의 데이터를 옮기려면 서버를 끄고: npm run db:copy
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# (선택) DB 서버 인증서까지 검증하려면 Supabase Database 설정에서 받은 인증서 파일 경로. 없으면 암호화만 합니다.
# DATABASE_SSL_CA=./prod-ca-2021.crt

# 익명 토큰 서명 키 (배포 때 반드시 긴 임의 문자열로 바꾸기)
JWT_SECRET=dev-only-secret-change-me

# 공유 링크에 들어가는 서버 주소 (휴대폰에서 열려면 PC의 내부 IP나 배포 주소)
PUBLIC_BASE_URL=http://localhost:4000

# Google Gemini API 키. 비워 두면 예시 결과(mock)로 동작합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 주 모델이 붐비면(503) 차례로 시도할 모델
GEMINI_FALLBACK_MODELS=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
# 0이면 생각(thinking)을 꺼서 빨라짐. 모델이 거부하면 빈 값으로
GEMINI_THINKING_BUDGET=0
LLM_TIMEOUT_MS=5000
# 만드는 법은 답이 길어 따로 (기본 20초)
# LLM_RECIPE_TIMEOUT_MS=20000

# 방향성을 넣었을 때 가까운 단어 몇 개 안에서 뽑을지 (기본 12)
# DIRECTION_POOL=12
# 나만의 카테고리: 연관 단어 40개 중 먼 10개와 가까운 5개의 평균 거리 차이가 이보다 작으면 '알 수 없는 이름'으로 본다 (Gemini 기본 0.03)
# MATCH_MIN_SPREAD=0.03
# 연관 단어로 인정할 최대 코사인 거리 (기본: 제한 없음)
# MATCH_MAX_DISTANCE=
